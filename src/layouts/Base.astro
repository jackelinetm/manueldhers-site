    <!-- Menú móvil (overlay) — se abre desde el botón del header -->
    <div class="m-menu" id="m-menu" data-open="false" role="dialog" aria-modal="true" aria-label="Menú principal" hidden>
      <div class="top">
        <span class="brand"><strong>M. D'Hers</strong> <span class="accent">Del Pozo</span></span>
        <button class="close" data-close-menu aria-label="Cerrar menú">✕</button>
      </div>
      <nav aria-label="Principal">
        <a href="/">Home <span class="small">Página principal</span></a>
        <a href="/bio/">Bio <span class="small">Sobre Manuel</span></a>
        <a href="/publicaciones/">Publicaciones <span class="small">Papers · Ensayos · Artículos</span></a>
        <a href="/blog/">Blog <span class="small">Diarios y notas de campo</span></a>
      </nav>
      <div class="foot">
        <span class="accent">◆</span> <a href="https://orcid.org/0000-0002-5812-2612">ORCID · 0000-0002-5812-2612</a><br />
        Tarragona · 2026
      </div>
    </div>

    <script>
      // === Menú móvil ===
      const menu = document.getElementById('m-menu');
      const openBtn = document.querySelector('[data-open-menu]');
      const closeBtns = document.querySelectorAll('[data-close-menu]');

      function openMenu() {
        if (!menu) return;
        menu.hidden = false;
        menu.dataset.open = 'true';
        document.body.dataset.menuOpen = 'true';
        if (openBtn) openBtn.setAttribute('aria-expanded', 'true');
        const firstLink = menu.querySelector('nav a');
        if (firstLink) (firstLink as HTMLElement).focus();
      }
      function closeMenu() {
        if (!menu) return;
        menu.dataset.open = 'false';
        menu.hidden = true;
        document.body.removeAttribute('data-menu-open');
        if (openBtn) {
          openBtn.setAttribute('aria-expanded', 'false');
          (openBtn as HTMLElement).focus();
        }
      }
      if (openBtn) openBtn.addEventListener('click', openMenu);
      closeBtns.forEach((b) => b.addEventListener('click', closeMenu));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menu && menu.dataset.open === 'true') closeMenu();
      });

      // Marcar enlace activo en el overlay móvil según pathname
      (function markActive() {
        const path = window.location.pathname;
        const links = menu ? menu.querySelectorAll('nav a') : [];
        links.forEach((a) => {
          const href = a.getAttribute('href');
          if (!href) return;
          if (href === '/' && path === '/') a.setAttribute('aria-current', 'page');
          else if (href !== '/' && path.startsWith(href)) a.setAttribute('aria-current', 'page');
        });
      })();

      // === Filtros de Publicaciones ===
      const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
      const filterItems = document.querySelectorAll<HTMLElement>('[data-tipo]');
      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.dataset.filter || 'all';
          filterBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
          filterItems.forEach((item) => {
            const tipo = item.getAttribute('data-tipo');
            const show = target === 'all' || tipo === target;
            if (show) item.removeAttribute('hidden');
            else item.setAttribute('hidden', '');
          });
        });
      });
    </script>
